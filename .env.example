# Local dev values only — never real secrets. See docs/PRD.md Appendix B
# for the full env var list across every phase; only the vars actually
# read by code today (Phase 1-2) are here. cmd/anvil, cmd/runner, and
# cmd/anvilctl are separate processes/binaries and read this
# independently — export these in your shell, or use
# `set -a; source .env; set +a` before running them.

# --- cmd/anvil (control plane) ---
ANVIL_HTTP_ADDR=:8080
DATABASE_URL=postgres://anvil:anvil@localhost:5432/anvil?sslmode=disable
DATABASE_MAX_CONNS=10
REDIS_URL=localhost:6379
ANVIL_JWT_SECRET=replace-with-32-plus-random-bytes
# AES-256-GCM key for envelope-encrypted user secrets (PRD §16.5) —
# exactly 32 bytes, never reused for anything else.
ANVIL_SECRET_ENCRYPTION_KEY=replace-with-exactly-32-random-b
# GitHub OAuth app (FR-001) — leave all unset to skip GitHub linking
# entirely; if any one is set, all three (excluding ANVIL_WEB_URL) are
# required. Register the app's callback URL as exactly
# ANVIL_GITHUB_REDIRECT_URL.
ANVIL_GITHUB_CLIENT_ID=
ANVIL_GITHUB_CLIENT_SECRET=
ANVIL_GITHUB_REDIRECT_URL=http://127.0.0.1:8080/auth/github/callback
# Frontend base URL to send the browser back to after linking
# succeeds. Empty means the callback returns a JSON confirmation
# instead of redirecting.
ANVIL_WEB_URL=
# URL the control plane uses to reach the Runner (not the Runner's own
# bind address below — PRD Appendix B names both ANVIL_RUNNER_ADDR;
# code splits them to avoid the ambiguity).
ANVIL_RUNNER_URL=http://127.0.0.1:9090
# LLM provider ladder (PRD §9.4) — at least one key required. The same
# vars are read by cmd/anvilctl bench. Default ladder order is
# Anthropic primary, OpenAI fallback, Gemini last (optional, not
# required — leave ANVIL_GEMINI_API_KEY unset to skip it entirely).
ANVIL_ANTHROPIC_API_KEY=
ANVIL_OPENAI_API_KEY=
ANVIL_OPENAI_MODEL=gpt-4o-mini
ANVIL_GEMINI_API_KEY=
ANVIL_GEMINI_MODEL=gemini-2.5-flash
ANVIL_MONTHLY_USD_CAP=10
ANVIL_MAX_STEPS=12
# Artifact storage (PRD §8.2) — S3-compatible, MinIO locally via
# `make dev`. Leave ANVIL_S3_ENDPOINT unset to skip artifact
# upload/download entirely; nothing else depends on it.
ANVIL_S3_ENDPOINT=localhost:9000
ANVIL_S3_BUCKET=anvil-artifacts
ANVIL_S3_ACCESS_KEY=anvil
ANVIL_S3_SECRET_KEY=anvilanvil
ANVIL_S3_USE_SSL=false
# Preview deployments (PRD §9.7, FR-060..FR-063). Leave
# ANVIL_PREVIEW_DOMAIN unset to skip deploy entirely — a job that
# requests options.deploy on a deployment with no preview domain
# configured fails that job at deploy time, not the whole control
# plane at startup. ANVIL_CADDY_ADMIN_ADDR must point at a running
# Caddy instance's admin API (ops/caddy/caddy.json), not a container —
# see docker-compose.yml's comment on why Caddy isn't a compose service.
ANVIL_PREVIEW_DOMAIN=
ANVIL_CADDY_ADMIN_ADDR=http://127.0.0.1:2019
# Observability (PRD §17.1). Leave unset to disable tracing entirely —
# see internal/telemetry.NewTracerProvider's own doc comment. Point at
# the otel-collector compose service's published OTLP/gRPC port when
# running the observability stack (`docker compose up otel-collector
# tempo prometheus grafana`).
ANVIL_OTEL_COLLECTOR_ENDPOINT=localhost:4317

# --- cmd/runner (sandbox Runner — separate process, own Docker socket access) ---
ANVIL_RUNNER_ADDR=127.0.0.1:9090
ANVIL_SANDBOX_IMAGE=anvil/workspace:test

# --- Observability stack (docker-compose.yml: otel-collector, tempo,
# prometheus, alertmanager, grafana — PRD §17, §18.1) ---
# Alertmanager → email (PRD §17.4). Required only if you run
# `docker compose up alertmanager`; alerts.yml's rules still evaluate
# without it, they just have nowhere to deliver to.
ANVIL_SMTP_HOST=
ANVIL_SMTP_PORT=587
ANVIL_SMTP_USERNAME=
ANVIL_SMTP_PASSWORD=
ANVIL_ALERT_FROM_EMAIL=
ANVIL_ALERT_TO_EMAIL=
# Grafana's Cost dashboard "spend by user" panel (ops/grafana/dashboards/
# cost.json) reads Postgres directly — same database DATABASE_URL above
# points at, just decomposed into the fields Grafana's datasource config
# wants instead of one DSN.
ANVIL_DATABASE_HOST=host.docker.internal
ANVIL_DATABASE_USER=anvil
ANVIL_DATABASE_PASSWORD=
