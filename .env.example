# Local dev values only — never real secrets. See docs/PRD.md Appendix B
# for the full env var list across every phase; only the vars actually
# read by code today (Phase 1-2) are here. cmd/anvil, cmd/runner, and
# cmd/anvilctl are separate processes/binaries and read this
# independently — export these in your shell, or use
# `set -a; source .env; set +a` before running them.

# --- cmd/anvil (control plane) ---
ANVIL_HTTP_ADDR=:8080
DATABASE_URL=postgres://anvil:anvil@localhost:5432/anvil?sslmode=disable
DATABASE_MAX_CONNS=10
REDIS_URL=localhost:6379
ANVIL_JWT_SECRET=replace-with-32-plus-random-bytes
# URL the control plane uses to reach the Runner (not the Runner's own
# bind address below — PRD Appendix B names both ANVIL_RUNNER_ADDR;
# code splits them to avoid the ambiguity).
ANVIL_RUNNER_URL=http://127.0.0.1:9090
# LLM provider ladder (PRD §9.4) — at least one key required. The same
# two vars are read by cmd/anvilctl bench.
ANVIL_GEMINI_API_KEY=
ANVIL_GEMINI_MODEL=gemini-2.5-flash
ANVIL_ANTHROPIC_API_KEY=
ANVIL_MONTHLY_USD_CAP=10

# --- cmd/runner (sandbox Runner — separate process, own Docker socket access) ---
ANVIL_RUNNER_ADDR=127.0.0.1:9090
ANVIL_SANDBOX_IMAGE=anvil/workspace:test
